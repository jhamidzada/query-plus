<Application x:Class="QueryPlus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent (Win11-style) theming for all standard controls. Light theme keeps
                     the AvalonEdit editor (white background) visually consistent. -->
                <ui:ThemeResources RequestedTheme="Light" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Soften list/tree/grid selection: the theme's accent selection is too dark and
                 stays saturated when focus leaves. These lighter blues keep dark text readable
                 and make a lingering selection subtle. (Direct entries override the merged
                 theme dictionaries at lookup time.) -->
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#FFCCE4F7" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#FFB9D9F2" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#FFA6CDEC" />

            <!-- Compact checkbox for bare (label-less) checkboxes in item rows: the theme's
                 CheckBox defaults to MinWidth=120/MinHeight=32, which wrecks row layout. -->
            <Style x:Key="CompactCheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ============================ Palette ============================
                 Semantic colours so a control's role is readable at a glance.
                 Values follow the Windows 11 system palette. -->
            <Color x:Key="BrandColor">#FF0F6CBD</Color>
            <Color x:Key="BrandDarkColor">#FF0C5A9E</Color>
            <Color x:Key="DangerColor">#FFC42B1C</Color>
            <Color x:Key="DangerDarkColor">#FFA23120</Color>
            <Color x:Key="SuccessColor">#FF0F7B0F</Color>

            <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
            <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FF1B4F7E" />
            <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFEFF4F9" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFAFBFC" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFD6DEE7" />

            <!-- ======================= Button variants ======================= -->

            <!-- Primary action (Execute, Save). -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BrandBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandDarkBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,5" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrandDarkBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FFD7DDE3" />
                        <Setter Property="Foreground" Value="#FF8A9199" />
                        <Setter Property="BorderBrush" Value="#FFC9D0D7" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Destructive / halting action (Stop). -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerDarkBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,5" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource DangerDarkBrush}" />
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FFD7DDE3" />
                        <Setter Property="Foreground" Value="#FF8A9199" />
                        <Setter Property="BorderBrush" Value="#FFC9D0D7" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Secondary action: neutral fill, brand-coloured text and border. -->
            <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFE3EFFA" />
                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#FF9AA2AA" />
                        <Setter Property="BorderBrush" Value="#FFD2D8DE" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Small buttons in dense panel headers (All / None / New / Files…). -->
            <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
                <Setter Property="Foreground" Value="#FF33414F" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFE9F1F9" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Panel headings ("Targets", "Scripts"). -->
            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource PanelHeaderBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,0,2,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
