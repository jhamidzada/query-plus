<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The exe/assembly is "QueryPlus" (not "QueryPlus.App") for a clean shippable name. -->
    <AssemblyName>QueryPlus</AssemblyName>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>QueryPlus</AssemblyTitle>
    <Product>QueryPlus</Product>

    <!-- Semantic version — the single source of truth for the app's version.
         MAJOR = breaking change, MINOR = new feature, PATCH = bug fix. -->
    <Version>1.1.1</Version>

    <!-- Appended by the SDK to InformationalVersion as "1.0.0+build.20260804.0812", so two builds
         of the same version are still distinguishable (shown in the version tooltip). -->
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">build.$([System.DateTime]::UtcNow.ToString("yyyyMMdd.HHmm"))</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueryPlus.Core\QueryPlus.Core.csproj" />
  </ItemGroup>

</Project>
